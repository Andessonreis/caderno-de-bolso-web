# Copie para .env.local se precisar mudar algo. Todas são opcionais.

# Prefixo quando o site fica num subcaminho (GitHub Pages).
NEXT_PUBLIC_BASE_PATH=

# Repositório do aplicativo, exibido na página inicial.
NEXT_PUBLIC_MOBILE_REPO_URL=

# Endereço público do site, base dos metadados de compartilhamento.
NEXT_PUBLIC_SITE_URL=

# Servidor da área do grupo (/grupo). Sem estas variáveis, o site usa estes
# mesmos valores. A chave é a pública (publishable), feita para ficar no
# navegador. Nunca coloque aqui a chave secreta ou a de serviço.
NEXT_PUBLIC_SUPABASE_URL=https://usnrgytoupqwikgcwwjb.supabase.co
NEXT_PUBLIC_SUPABASE_KEY=sb_publishable_2Qv8OPUk-Aj9zHOIxEXwzA_yBvYG5g4
